{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Tiptap",
  "version": "0.16.0",
  "identifier": "com.smallproject.mdtiptap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MD Tiptap 시험판",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
