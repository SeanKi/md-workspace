{
  "name": "md-workspace",
  "private": true,
  "version": "0.15.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "editor": "npm run start -w md-editor",
    "sync-note": "npm run start -w md-sync-note",
    "build:editor": "npm run release -w md-editor",
    "build:sync-note": "npm run release -w md-sync-note",
    "tiptap": "npm run start -w md-tiptap",
    "tiptap:web": "npm run dev -w md-tiptap",
    "test:roundtrip": "node packages/editor-tiptap/test/roundtrip.mjs"
  }
}
